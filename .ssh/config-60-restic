# If I can connect to truenas without tailscale, do.
Match originalhost restic-backups-to-truenas exec "nc -z -w 5 truenas.local 22 >& /dev/null"
    HostName truenas.local

Host restic-backups-to-truenas
    HostName truenas-scale.tail3ff93.ts.net
    IdentityFile ~/.ssh/keys/restic-backups-to-truenas
    # Restic already compresses everything.
    Compression no
    ForwardAgent no
    ForwardX11 no
    ControlMaster no
    ControlPath none
    PasswordAuthentication no
    RequestTTY no

Host restic-backups-to-rsync-net
    HostName zh3483.rsync.net
    User zh3483
    IdentityFile ~/.ssh/keys/restic-backups-to-rsync-net
    # Restic already compresses everything.
    Compression no
    ForwardAgent no
    ForwardX11 no
    ControlMaster no
    ControlPath none
    PasswordAuthentication no
    RequestTTY no
