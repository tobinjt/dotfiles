#!/bin/zsh

# keep-sorted start block=yes newline_separated=yes
# Renames the directory portion of the tmux window title while a command runs.
rename-directory-while-command-runs() {
  tmux_title_set_directory_portion "$1"
  tmux_title_update
  shift
  local exit_status=0
  {
    "$@"
    exit_status=$?
  } always {
    tmux_title_hook
  }
  return "${exit_status}"
}

# Appends to the tmux window title while a command runs.
rename-window-while-command-runs() {
  tmux_title_push "$1"
  shift
  local exit_status=0
  {
    "$@"
    exit_status=$?
  } always {
    tmux_title_pop
  }
  return "${exit_status}"
}
# keep-sorted end

# Local stuff
local_zsh_aliases="${HOME}/.zsh_aliases-local"
if [[ -f "${local_zsh_aliases}" ]]; then
  . "${local_zsh_aliases}"
fi
